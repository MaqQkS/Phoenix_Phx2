# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Test artifacts
PHX2/.test_tmp/
PHX2/.test_tmp_pytest/
.pytest_cache/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Logs
*.log
logs/

# Runtime data
data/*.db
data/*.db-*

# Stage 12 analysis output (immutable run artifacts, never committed)
PHX2/analysis/output/*
!PHX2/analysis/output/.gitkeep

# Stage 13 policy-review output (immutable run artifacts, never committed)
PHX2/stage13_runs/

# Stage 16A observe-only runtime policy output (immutable run artifacts)
PHX2/stage16a_runs/
stage16a_runs/
PHX2/stage17_runs/
PHX2/stage18_runs/
PHX2/stage19_runs/
stage20_closure_runs/

# Local pytest --basetemp dirs (used to bypass system temp ACL issues).
# Stages that create fresh basetemp paths per phase
# (e.g. .pytest_basetmp_stage16b_p1, .pytest_basetmp_stage16b_p2)
# accumulate these on Windows; ignore every variant.
.pytest_basetmp*
.pytest_basetmp*/

# OS / IDE
Thumbs.db
.DS_Store
.vscode/
.idea/

# Secrets
.env
.env.*

# Claude Code session metadata
.claude/

